{
  "name": "@raahi/myraahi-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "ui:test": "playwright test",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply myraahi-shell-db --local",
    "db:seed:local": "wrangler d1 execute myraahi-shell-db --local --file=fixtures/dev-seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@playwright/test": "1.55.0",
    "typescript": "^5.9.2",
    "wrangler": "4.140.0"
  }
}
